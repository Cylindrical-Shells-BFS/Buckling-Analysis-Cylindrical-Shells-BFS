Notebook[{
Cell[TextData[{
 "FE analysis of plate bending using Bogner-Fox-Schmit shape functions, which \
guarantee ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["C", "1"], TraditionalForm]],ExpressionUUID->
  "3e787795-7c69-44da-b60b-9f45e0ba16c6"],
 " interelement continuity.\n(c) 2019 Yury Vetyukov, TU Wien, Austria\nSee\n- \
",
 StyleBox["Yu. Vetyukov, Finite element modeling of Kirchhoff\[Hyphen]Love \
shells as smooth material surfaces, ZAMM\[Hyphen]Journal of Applied \
Mathematics and Mechanics/Zeitschrift f\[UDoubleDot]r Angewandte Mathematik \
und Mechanik, Vol. 94, Issue 1-2, 2014, pp. 150-163\n- Yu. Vetyukov, \
Nonlinear mechanics of thin-walled structures: asymptotics, direct approach \
and numerical analysis, Springer, 2014\n",
  FontSlant->"Italic"],
 "for details and convergence studies."
}], "Text",
 CellChangeTimes->{{3.7586148753409386`*^9, 3.7586149458493795`*^9}, {
  3.7586150045663877`*^9, 3.758615059622856*^9}, {3.7586160536160336`*^9, 
  3.758616057796523*^9}, {3.7586161058270197`*^9, 3.7586161137268915`*^9}, {
  3.758616175086336*^9, 
  3.758616191974498*^9}},ExpressionUUID->"e5a6e880-64f4-4210-b560-\
0b07f0d93bf0"],

Cell[CellGroupData[{

Cell["shape functions, degrees of freedom and approximation", "Subsection",
 CellChangeTimes->{{3.5775324626673985`*^9, 3.5775324643624954`*^9}, {
  3.6756646456688957`*^9, 
  3.675664653354268*^9}},ExpressionUUID->"f546186c-47f3-4e77-b154-\
397aef11dc6f"],

Cell["\<\
the element has four nodes and features cubic shape functions, such that the \
deflection itself, the two first order derivatives and the mixed second order \
derivative of the deflection with respect to the local coordinates q1, q2  \
appear as nodal degrees of freedom\
\>", "Text",
 CellChangeTimes->{{3.7586150894700146`*^9, 3.7586151587447634`*^9}, {
  3.758615721473276*^9, 
  3.7586157262834625`*^9}},ExpressionUUID->"ca64b266-863b-4817-9391-\
e6d72160993f"],

Cell["\<\
shape functions for the approximation of the lateral deflection\
\>", "Text",
 CellChangeTimes->{{3.675664671669348*^9, 
  3.6756646808079042`*^9}},ExpressionUUID->"8134224f-00f6-4687-9a35-\
3ada64323a97"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"sfGeneral", "=", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"q2", "-", "1"}], ")"}], "2"], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"q1", "-", "1"}], ")"}], "2"], 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2", "+", "q2"}], ")"}], "  ", 
         RowBox[{"(", 
          RowBox[{"2", "+", "q1"}], ")"}]}], ",", 
        RowBox[{"k1", " ", 
         RowBox[{"(", 
          RowBox[{"2", "+", "q2"}], ")"}], "  ", 
         RowBox[{"(", 
          RowBox[{"1", "+", "q1"}], ")"}]}], ",", 
        RowBox[{"k2", " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", "q2"}], ")"}], "  ", 
         RowBox[{"(", 
          RowBox[{"2", "+", "q1"}], ")"}]}], ",", 
        RowBox[{"k1", " ", "k2", 
         RowBox[{"(", 
          RowBox[{"1", "+", "q2"}], ")"}], "  ", 
         RowBox[{"(", 
          RowBox[{"1", "+", "q1"}], ")"}]}]}], "}"}], "/", "16"}]}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"q1", "\[Rule]", 
       RowBox[{"k1", " ", "q1"}]}], ",", 
      RowBox[{"q2", "\[Rule]", 
       RowBox[{"k2", " ", "q2"}]}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"Plot3D", "[", 
    RowBox[{"sf", ",", 
     RowBox[{"{", 
      RowBox[{"q1", ",", 
       RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"q2", ",", 
       RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
     RowBox[{"ImageSize", "\[Rule]", "160"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"sf", ",", 
     RowBox[{"sfGeneral", "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"k1", "\[Rule]", "1"}], ",", 
        RowBox[{"k2", "\[Rule]", "1"}]}], "}"}]}]}], "}"}]}], "]"}]}], "Input",
