   3.5777818123649406`*^9, 3.577781837489385*^9}, 3.577789182228489*^9, {
   3.5777892186545534`*^9, 3.5777892192317543`*^9}, {3.5781114861632404`*^9, 
   3.578111487052442*^9}, {3.578111583958612*^9, 3.578111603380646*^9}, {
