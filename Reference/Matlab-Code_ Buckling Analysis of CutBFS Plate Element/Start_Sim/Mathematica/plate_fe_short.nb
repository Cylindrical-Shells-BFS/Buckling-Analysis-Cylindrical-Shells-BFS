Cell[CellGroupData[{

Cell["plate: potential energy and strain energy", "Subsection",
 CellChangeTimes->{{3.5775327154968596`*^9, 3.5775327251604123`*^9}, {
  3.5775905307682*^9, 3.577590542239856*^9}, {3.7364931309692087`*^9, 
  3.7364931334706016`*^9}, {3.758615694887413*^9, 
  3.7586156953421526`*^9}},ExpressionUUID->"1ed922de-02c7-4fa0-a7b1-\
3ed2be5b2aeb"],

Cell[TextData[{
 "the size of the finite element is h, and dx = h/2 dq1, dy = h/2 dq2, and \
during integration dx dy = ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["h", "2"], TraditionalForm]],ExpressionUUID->
  "85cba2fa-a18f-4036-93d3-1640ad1ef69e"],
 "/4 dq1 dq2.\nnow we can integrate the potential of external forces - energy \
in the field of gravity; g is the gravity acceleration, and \[Rho] is the \
density per unit area"
}], "Text",
 CellChangeTimes->{{3.528780400866371*^9, 3.5287805951224823`*^9}, {
  3.5287832268770094`*^9, 3.528783274195716*^9}, {3.5777818054541287`*^9, 
  3.577781836709384*^9}, {3.75861569835411*^9, 
  3.7586157017759523`*^9}},ExpressionUUID->"29220fa8-56bb-4c5a-b60a-\
1a841c2dd11b"],

Cell[BoxData[{
 RowBox[{"Needs", "[", "\"\<NumericalDifferentialEquationAnalysis`\>\"", 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GP", "=", 
   RowBox[{"GaussianQuadratureWeights", "[", 
    RowBox[{"4", ",", 
     RowBox[{"-", "1"}], ",", "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"IntegrateElement", "[", "f_", "]"}], ":=", 
  RowBox[{"Sum", "[", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       SuperscriptBox["H", "2"], "/", "4"}], 
      RowBox[{"gp1", "[", 
       RowBox[{"[", "2", "]"}], "]"}], 
      RowBox[{"gp2", "[", 
       RowBox[{"[", "2", "]"}], "]"}], "f"}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"q1", "\[Rule]", 
        RowBox[{"gp1", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ",", 
       RowBox[{"q2", "\[Rule]", 
        RowBox[{"gp2", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], "}"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"gp1", ",", "GP"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"gp2", ",", "GP"}], "}"}]}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.5775328520096674`*^9, 3.577532852186678*^9}, {
   3.5775329129211516`*^9, 3.5775329226967106`*^9}, {3.5775900887729187`*^9, 
   3.5775901650312805`*^9}, {3.577781810087337*^9, 3.5777818371929846`*^9}, {
   3.5777891772520804`*^9, 3.577789209996538*^9}, {3.57778925082181*^9, 
   3.57778925093101*^9}, 3.7657781496102905`*^9, 
   3.76577819804596*^9},ExpressionUUID->"c14300d2-8c66-4bbc-ae95-\
1823643a2c7e"],

Cell["potential energy in the field of gravity", "Text",
 CellChangeTimes->{{3.758615792103425*^9, 
  3.758615797374338*^9}},ExpressionUUID->"710308e0-b7fb-4eab-901e-\
d92b07df144b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"UelExt", "=", 
   RowBox[{"Expand", "[", 
    RowBox[{"IntegrateElement", "[", 
     RowBox[{"\[Rho]", " ", "h", " ", "g", " ", "w"}], "]"}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.5287805681609397`*^9, 3.528780656119971*^9}, {
   3.5287821122972593`*^9, 3.528782133496472*^9}, 3.528783281031107*^9, 
