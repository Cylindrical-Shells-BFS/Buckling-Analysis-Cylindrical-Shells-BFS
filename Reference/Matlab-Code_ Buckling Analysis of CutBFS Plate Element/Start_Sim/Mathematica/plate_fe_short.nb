Cell[BoxData[
 RowBox[{
  RowBox[{"LocalToGlobal", "[", 
   RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     SubscriptBox["e_", "1"], "\[Rule]", 
     SubscriptBox["e", 
      RowBox[{
       RowBox[{"i", "-", "1"}], ",", 
       RowBox[{"j", "-", "1"}]}]]}], ",", 
    RowBox[{
     SubscriptBox["e_", "2"], "\[Rule]", 
     SubscriptBox["e", 
      RowBox[{"i", ",", 
       RowBox[{"j", "-", "1"}]}]]}], ",", 
    RowBox[{
     SubscriptBox["e_", "3"], "\[Rule]", 
     SubscriptBox["e", 
      RowBox[{"i", ",", "j"}]]}], ",", 
    RowBox[{
     SubscriptBox["e_", "4"], "\[Rule]", 
     SubscriptBox["e", 
      RowBox[{
       RowBox[{"i", "-", "1"}], ",", "j"}]]}]}], "}"}]}]], "Input",
