Cell["\<\
and now the boundary conditions: the plate is clamped at all four edges, and \
all degrees of freedom at these edges are to be constrained\
\>", "Text",
 CellChangeTimes->{{3.528784679187077*^9, 3.5287846970430984`*^9}, {
  3.5775933434510756`*^9, 
  3.577593357706891*^9}},ExpressionUUID->"87464435-77ea-4256-af6c-\
593b1cdf5b1d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dofConstrained", "=", 
   RowBox[{"Flatten", "[", 
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"dofLocal", "[", "1", "]"}], "/.", 
         RowBox[{"LocalToGlobal", "[", 
          RowBox[{"1", ",", "j"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "n"}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"dofLocal", "[", "3", "]"}], "/.", 
         RowBox[{"LocalToGlobal", "[", 
          RowBox[{"n", ",", "j"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "n"}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"dofLocal", "[", "2", "]"}], "/.", 
         RowBox[{"LocalToGlobal", "[", 
          RowBox[{"i", ",", "1"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "n"}], "}"}]}], "]"}], ",", "\[IndentingNewLine]", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"dofLocal", "[", "4", "]"}], "/.", 
         RowBox[{"LocalToGlobal", "[", 
          RowBox[{"i", ",", "n"}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "n"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
     "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"constraints", "=", 
   RowBox[{"Thread", "[", 
    RowBox[{"dofConstrained", "\[Rule]", "0"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.577593517463029*^9, 3.5775935403803396`*^9}, {
   3.5775938078016353`*^9, 3.577593808875696*^9}, {3.577593892457477*^9, 
   3.577593970554944*^9}, {3.577594372727947*^9, 3.577594400825554*^9}, {
